# Copie para .env.local. Nunca commite segredos.

# URL do backend NestJS (o navegador NUNCA fala direto com ele: tudo passa pelo servidor do Next, o BFF).
API_URL=http://localhost:3000

# Cookies de sessão: "false" apenas para rodar localmente em http. Em produção (https) deixe true.
COOKIE_SECURE=false

# Nome exibido no topo e na tela de login.
NEXT_PUBLIC_APP_NAME="ERP PME"
