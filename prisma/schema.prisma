generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// MULTI-TENANT: toda tabela operacional carrega idEmpresa.
// ============================================================================

model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  cnpj      String   @unique
  email     String   @unique
  telefone  String?
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios      Usuario[]
  clientes      Cliente[]
  fornecedores  Fornecedor[]
  departamentos Departamento[]
  produtos      Produto[]
  estoques      Estoque[]
  pedidos       Pedido[]
  financeiros   TransacaoFinanceira[]
  usuarioPerms  UsuarioPermissao[]

  // Relações inversas obrigatórias no Prisma 7:
  pessoas           Pessoa[]
  categorias        CategoriaProduto[]
  precos            PrecoProduto[]
  estoqueMovimentos EstoqueMovimento[]
  itensPedido       ItemPedido[]
  planoContas       PlanoContas[]
  centrosCusto      CentroCusto[]
  almoxarifados     Almoxarifado[]
  formasPagamento   FormaPagamento[]
  unidadesMedida    UnidadeMedida[]
  marcas            Marca[]
  statusPedidos     StatusPedido[]
  statusProdutos    StatusProduto[]

  compras           Compra[]
  itensCompra       ItemCompra[]
  sessoesRefresh    SessaoRefresh[]
  departamentoPerms DepartamentoPermissao[]
}

// ----------------------------------------------------------------------------
// Pessoas e acesso
// ----------------------------------------------------------------------------

model Pessoa {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String
  email     String
  cpfCnpj   String
  telefone  String?
  endereco  String?
  tipo      String // 'FISICA' ou 'JURIDICA'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa    Empresa     @relation(fields: [idEmpresa], references: [id])
  cliente    Cliente?
  fornecedor Fornecedor?
  usuario    Usuario?

  @@unique([idEmpresa, cpfCnpj])
  @@unique([idEmpresa, email])
  @@unique([id, idEmpresa])
}

model Cliente {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  pessoaId  Int      @unique
  codigo    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa  @relation(fields: [idEmpresa], references: [id])
  pessoa  Pessoa   @relation(fields: [pessoaId, idEmpresa], references: [id, idEmpresa])
  pedidos Pedido[]

  @@unique([pessoaId, idEmpresa])
  @@unique([id, idEmpresa])
}

model Fornecedor {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  pessoaId  Int      @unique
  codigo    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa @relation(fields: [idEmpresa], references: [id])
  pessoa  Pessoa  @relation(fields: [pessoaId, idEmpresa], references: [id, idEmpresa])

  compras Compra[]

  @@unique([pessoaId, idEmpresa])
  @@unique([id, idEmpresa])
}

model Departamento {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String
  sigla     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa    Empresa                 @relation(fields: [idEmpresa], references: [id])
  usuarios   Usuario[]
  permissoes DepartamentoPermissao[]

  @@unique([idEmpresa, nome])
  @@unique([id, idEmpresa])
}

model Usuario {
  id             Int      @id @default(autoincrement())
  idEmpresa      Int
  pessoaId       Int      @unique
  departamentoId Int? // objetivo (d): acesso por departamento
  username       String
  password       String
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa        Empresa            @relation(fields: [idEmpresa], references: [id])
  pessoa         Pessoa             @relation(fields: [pessoaId, idEmpresa], references: [id, idEmpresa])
  departamento   Departamento?      @relation(fields: [departamentoId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)
  permissoes     UsuarioPermissao[]
  movimentos     EstoqueMovimento[]
  sessoesRefresh SessaoRefresh[]
  pedidos        Pedido[]

  compras Compra[]

  @@unique([idEmpresa, username])
  @@unique([pessoaId, idEmpresa])
  @@unique([id, idEmpresa])
}

model Permissao {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios      UsuarioPermissao[]
  departamentos DepartamentoPermissao[]
}

model UsuarioPermissao {
  id          Int      @id @default(autoincrement())
  idEmpresa   Int
  usuarioId   Int
  permissaoId Int
  createdAt   DateTime @default(now())

  empresa   Empresa   @relation(fields: [idEmpresa], references: [id])
  usuario   Usuario   @relation(fields: [usuarioId, idEmpresa], references: [id, idEmpresa])
  permissao Permissao @relation(fields: [permissaoId], references: [id])

  @@unique([usuarioId, permissaoId])
}

model DepartamentoPermissao {
  id             Int          @id @default(autoincrement())
  idEmpresa      Int
  departamentoId Int
  permissaoId    Int
  empresa        Empresa      @relation(fields: [idEmpresa], references: [id])
  departamento   Departamento @relation(fields: [departamentoId, idEmpresa], references: [id, idEmpresa])
  permissao      Permissao    @relation(fields: [permissaoId], references: [id])

  @@unique([departamentoId, permissaoId])
}

model SessaoRefresh {
  id         Int       @id @default(autoincrement())
  idEmpresa  Int
  usuarioId  Int
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  empresa    Empresa   @relation(fields: [idEmpresa], references: [id])
  usuario    Usuario   @relation(fields: [usuarioId, idEmpresa], references: [id, idEmpresa])

  @@index([idEmpresa, usuarioId])
  @@index([expiraEm])
}

// ----------------------------------------------------------------------------
// Produtos (objetivo e): categoria, marca, unidade de medida, cor e referência
// ----------------------------------------------------------------------------

model CategoriaProduto {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa   @relation(fields: [idEmpresa], references: [id])
  produtos Produto[]

  @@unique([id, idEmpresa])
}

model Marca {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa   @relation(fields: [idEmpresa], references: [id])
  produtos Produto[]

  @@unique([idEmpresa, nome])
  @@unique([id, idEmpresa])
}

model UnidadeMedida {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  sigla     String // Ex: "UN", "KG", "CX"
  nome      String // Ex: "Unidade", "Quilograma", "Caixa"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa   @relation(fields: [idEmpresa], references: [id])
  produtos Produto[]

  @@unique([idEmpresa, sigla])
  @@unique([id, idEmpresa])
}

model Produto {
  id                 Int      @id @default(autoincrement())
  idEmpresa          Int
  categoriaId        Int
  unidadeMedidaId    Int
  marcaId            Int?
  nome               String
  descricao          String?
  sku                String
  referencia         String?
  cor                String?
  precoCusto         Decimal  @db.Decimal(10, 2)
  estoqueMinimo      Decimal  @default(0) @db.Decimal(12, 3)
  alertaEstoqueAtivo Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empresa       Empresa          @relation(fields: [idEmpresa], references: [id])
  categoria     CategoriaProduto @relation(fields: [categoriaId, idEmpresa], references: [id, idEmpresa])
  unidadeMedida UnidadeMedida    @relation(fields: [unidadeMedidaId, idEmpresa], references: [id, idEmpresa])
  marca         Marca?           @relation(fields: [marcaId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)
  estoques      Estoque[]
  itensPedido   ItemPedido[]
  precos        PrecoProduto[]

  itensCompra ItemCompra[]

  @@unique([idEmpresa, sku])
  @@unique([id, idEmpresa])
}

model PrecoProduto {
  id         Int      @id @default(autoincrement())
  idEmpresa  Int
  produtoId  Int
  nomeTabela String   @default("Padrão")
  precoVenda Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  empresa Empresa @relation(fields: [idEmpresa], references: [id])
  produto Produto @relation(fields: [produtoId, idEmpresa], references: [id, idEmpresa], onDelete: Cascade)

  @@unique([idEmpresa, produtoId, nomeTabela])
  @@index([idEmpresa, produtoId])
}

// ----------------------------------------------------------------------------
// Estoque
// ----------------------------------------------------------------------------

model Almoxarifado {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String // Ex: "Depósito Central"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa  Empresa   @relation(fields: [idEmpresa], references: [id])
  estoques Estoque[]
  pedidos  Pedido[]

  compras Compra[]

  @@unique([idEmpresa, nome])
  @@unique([id, idEmpresa])
}

model Estoque {
  id                Int      @id @default(autoincrement())
  idEmpresa         Int
  almoxarifadoId    Int
  produtoId         Int
  quantidade        Decimal  @default(0) @db.Decimal(12, 3)
  ultimaAtualizacao DateTime @updatedAt

  empresa       Empresa            @relation(fields: [idEmpresa], references: [id])
  almoxarifado  Almoxarifado       @relation(fields: [almoxarifadoId, idEmpresa], references: [id, idEmpresa])
  produto       Produto            @relation(fields: [produtoId, idEmpresa], references: [id, idEmpresa])
  movimentacoes EstoqueMovimento[]

  @@unique([idEmpresa, almoxarifadoId, produtoId])
  @@unique([id, idEmpresa])
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
}

model EstoqueMovimento {
  id            Int                  @id @default(autoincrement())
  idEmpresa     Int
  estoqueId     Int
  usuarioId     Int
  pedidoId      Int? // origem, quando a movimentação vem de um pedido
  tipo          TipoMovimentoEstoque
  qtdAnterior   Decimal              @db.Decimal(12, 3)
  qtdModificada Decimal              @db.Decimal(12, 3) // sempre positiva; o sentido está em "tipo"
  qtdPosterior  Decimal              @db.Decimal(12, 3)
  observacao    String
  createdAt     DateTime             @default(now())

  empresa Empresa @relation(fields: [idEmpresa], references: [id])
  estoque Estoque @relation(fields: [estoqueId, idEmpresa], references: [id, idEmpresa])
  usuario Usuario @relation(fields: [usuarioId, idEmpresa], references: [id, idEmpresa])
  pedido  Pedido? @relation(fields: [pedidoId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)

  compraId Int?
  compra   Compra? @relation(fields: [compraId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)

  @@index([idEmpresa, estoqueId, createdAt])
  @@index([pedidoId])
  @@index([idEmpresa, compraId])
}

// ----------------------------------------------------------------------------
// Pedidos (objetivo c): status configuráveis por empresa
// ----------------------------------------------------------------------------

model StatusPedido {
  id             Int      @id @default(autoincrement())
  idEmpresa      Int
  nome           String
  ordem          Int      @default(0)
  ehInicial      Boolean  @default(false) // status atribuído ao criar o pedido
  ehFinal        Boolean  @default(false) // encerra o fluxo (entregue, cancelado...)
  ehCancelamento Boolean  @default(false) // ao entrar neste status: estorna estoque e financeiro
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  empresa Empresa  @relation(fields: [idEmpresa], references: [id])
  pedidos Pedido[]

  @@unique([idEmpresa, nome])
  @@unique([id, idEmpresa])
}

model StatusProduto {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String // status do ITEM no pedido. Ex: "Pendente", "Separado", "Entregue"
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa Empresa      @relation(fields: [idEmpresa], references: [id])
  itens   ItemPedido[]

  @@unique([idEmpresa, nome])
  @@unique([id, idEmpresa])
}

model Pedido {
  id               Int      @id @default(autoincrement())
  idEmpresa        Int
  referencia       String
  clienteId        Int
  usuarioId        Int // quem criou o pedido
  almoxarifadoId   Int // de onde sai a baixa de estoque
  formaPagamentoId Int?
  statusId         Int
  dataPedido       DateTime @default(now())
  valorTotal       Decimal  @db.Decimal(12, 2)
  observacao       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empresa        Empresa              @relation(fields: [idEmpresa], references: [id])
  cliente        Cliente              @relation(fields: [clienteId, idEmpresa], references: [id, idEmpresa])
  usuario        Usuario              @relation(fields: [usuarioId, idEmpresa], references: [id, idEmpresa])
  almoxarifado   Almoxarifado         @relation(fields: [almoxarifadoId, idEmpresa], references: [id, idEmpresa])
  formaPagamento FormaPagamento?      @relation(fields: [formaPagamentoId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)
  status         StatusPedido         @relation(fields: [statusId, idEmpresa], references: [id, idEmpresa])
  itens          ItemPedido[]
  financeiro     TransacaoFinanceira?
  movimentos     EstoqueMovimento[]

  @@unique([id, idEmpresa])
  @@unique([idEmpresa, referencia])
  @@index([idEmpresa, dataPedido])
  @@index([idEmpresa, statusId])
}

model ItemPedido {
  id            Int     @id @default(autoincrement())
  idEmpresa     Int
  pedidoId      Int
  produtoId     Int
  statusId      Int?
  quantidade    Decimal @db.Decimal(12, 3)
  custoUnitario Decimal @db.Decimal(10, 2) // custo cadastrado no momento da venda
  valorUnitario Decimal @db.Decimal(10, 2)
  valorTotal    Decimal @db.Decimal(12, 2)

  empresa Empresa        @relation(fields: [idEmpresa], references: [id])
  pedido  Pedido         @relation(fields: [pedidoId, idEmpresa], references: [id, idEmpresa])
  produto Produto        @relation(fields: [produtoId, idEmpresa], references: [id, idEmpresa])
  status  StatusProduto? @relation(fields: [statusId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)

  @@unique([idEmpresa, pedidoId, produtoId])
  @@index([pedidoId])
}

// ----------------------------------------------------------------------------
// Financeiro / Tesouraria
// ----------------------------------------------------------------------------

model PlanoContas {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  codigo    String // Ex: "1.1.01"
  nome      String // Ex: "Receita de Vendas"
  tipo      String // 'RECEITA' ou 'DESPESA'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa    Empresa               @relation(fields: [idEmpresa], references: [id])
  transacoes TransacaoFinanceira[]

  @@unique([idEmpresa, codigo])
  @@unique([id, idEmpresa])
}

model CentroCusto {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String // Ex: "Comercial"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa    Empresa               @relation(fields: [idEmpresa], references: [id])
  transacoes TransacaoFinanceira[]

  @@unique([id, idEmpresa])
}

// Formas / Métodos de Pagamento (Dinheiro, Pix, Cartão, Boleto)
model FormaPagamento {
  id        Int      @id @default(autoincrement())
  idEmpresa Int
  nome      String // Ex: "Pix", "Cartão de Crédito 3x"
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresa    Empresa               @relation(fields: [idEmpresa], references: [id])
  transacoes TransacaoFinanceira[]
  pedidos    Pedido[]

  @@unique([idEmpresa, nome])
  @@unique([id, idEmpresa])
}

model TransacaoFinanceira {
  id               Int       @id @default(autoincrement())
  idEmpresa        Int
  pedidoId         Int?      @unique
  planoContasId    Int?
  centroCustoId    Int?
  formaPagamentoId Int?
  descricao        String
  valor            Decimal   @db.Decimal(12, 2)
  tipo             String // 'RECEITA' ou 'DESPESA'
  dataVencimento   DateTime
  dataPagamento    DateTime?
  status           String // 'PENDENTE', 'PAGO', 'CANCELADO' ("atrasado" é derivado)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  empresa        Empresa         @relation(fields: [idEmpresa], references: [id])
  pedido         Pedido?         @relation(fields: [pedidoId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)
  planoContas    PlanoContas?    @relation(fields: [planoContasId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)
  centroCusto    CentroCusto?    @relation(fields: [centroCustoId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)

  compraId Int?    @unique
  compra   Compra? @relation(fields: [compraId, idEmpresa], references: [id, idEmpresa], onDelete: Restrict)

  @@unique([pedidoId, idEmpresa])
  @@unique([compraId, idEmpresa])
  @@index([idEmpresa, dataVencimento])
  @@index([idEmpresa, status])
}

// Compras recebidas: registro, estoque e conta a pagar na mesma transação.
model Compra {
  id             Int                  @id @default(autoincrement())
  idEmpresa      Int
  referencia     String
  fornecedorId   Int
  usuarioId      Int
  almoxarifadoId Int
  valorTotal     Decimal              @db.Decimal(12, 2)
  acrescimos     Decimal              @default(0) @db.Decimal(12, 2)
  desconto       Decimal              @default(0) @db.Decimal(12, 2)
  notaNumero     String?
  notaSerie      String?
  notaChave      String?
  notaEmissao    DateTime?
  observacao     String?
  createdAt      DateTime             @default(now())
  empresa        Empresa              @relation(fields: [idEmpresa], references: [id])
  fornecedor     Fornecedor           @relation(fields: [fornecedorId, idEmpresa], references: [id, idEmpresa])
  usuario        Usuario              @relation(fields: [usuarioId, idEmpresa], references: [id, idEmpresa])
  almoxarifado   Almoxarifado         @relation(fields: [almoxarifadoId, idEmpresa], references: [id, idEmpresa])
  itens          ItemCompra[]
  movimentos     EstoqueMovimento[]
  financeiro     TransacaoFinanceira?

  @@unique([id, idEmpresa])
  @@unique([idEmpresa, referencia])
  @@unique([idEmpresa, notaChave])
  @@unique([idEmpresa, fornecedorId, notaNumero, notaSerie])
  @@index([idEmpresa, createdAt])
}

model ItemCompra {
  id            Int     @id @default(autoincrement())
  idEmpresa     Int
  compraId      Int
  produtoId     Int
  sequencia     Int
  quantidade    Decimal @db.Decimal(12, 3)
  valorUnitario Decimal @db.Decimal(21, 10)
  valorTotal    Decimal @db.Decimal(12, 2)
  empresa       Empresa @relation(fields: [idEmpresa], references: [id])
  compra        Compra  @relation(fields: [compraId, idEmpresa], references: [id, idEmpresa])
  produto       Produto @relation(fields: [produtoId, idEmpresa], references: [id, idEmpresa])

  @@unique([idEmpresa, compraId, sequencia])
}
