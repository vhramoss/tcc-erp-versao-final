# Copie para .env e ajuste. Nunca commite o .env.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/erp?schema=public"
PORT=3000
NODE_ENV=development

# Gere dois segredos aleatórios distintos; sem valores padrão em produção.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Apenas para o seed de desenvolvimento (12 a 128 caracteres).
SEED_ADMIN_PASSWORD=
