# Copie para .env e ajuste. NUNCA commite o .env nem coloque senhas reais neste arquivo de exemplo.

# Conexão com o PostgreSQL. Se a senha tiver caracteres especiais, codifique na URL (@ vira %40, # vira %23).
# Use um banco EXCLUSIVO deste sistema. Se o provedor exigir SSL, acrescente ?sslmode=require.
DATABASE_URL="postgresql://divimax:Divimax%402020@pgsql.divimax.com.br:5432/divimax"

# Porta da API (o PostgreSQL usa 5432: não repita aqui). O frontend roda em 3001.
PORT=3000
NODE_ENV=development

# Atrás do BFF/proxy, informe em quem confiar para enxergar o IP real no limitador de login:
# "loopback" (frontend na mesma máquina), um número de saltos (ex.: 1) ou uma sub-rede. Vazio = não confia.
TRUST_PROXY=loopback

# Gere dois segredos aleatórios distintos; sem valores padrão em produção.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=szWrmAuI_qpzFAOEtEXrSxCEXqhNWBz7MDI3Jq94VwguHyj1tFDc0vZ-MIbLBPOu
JWT_REFRESH_SECRET=rj0tZz7AyDFpbtBPQCLu-rTKT1Cps3bMqA_Wq9wN3FY9F4rXAdXCZPulgfvYm0a8

# Apenas para o seed de desenvolvimento (12 a 128 caracteres).
SEED_ADMIN_PASSWORD=
